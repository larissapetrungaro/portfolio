{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/axl-seguros",
      "destination": "/projetos/axl-seguros/",
      "permanent": true
    },
    {
      "source": "/clubee",
      "destination": "/projetos/clubee/",
      "permanent": true
    },
    {
      "source": "/axl-seguros/",
      "destination": "/projetos/axl-seguros/",
      "permanent": true
    },
    {
      "source": "/clubee/",
      "destination": "/projetos/clubee/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}